# 이 파일을 .env 로 복사한 뒤 값을 채운다 (sh setup.sh 가 복사해 준다).
# .env 는 Git에 올리지 않는다.

# 묵상 부분이 쓰는 Anthropic API 키
ANTHROPIC_API_KEY=

# 성경 DB 경로 (비워 두면 bible/bible_clean.db)
# BIBLE_DB=/경로/bible_clean.db

# AI 모델. 일에 따라 둘로 나눈다 (meditation/ai_client.py 맨 위 설명 참고)
# 큰 모델: 묵상 인도, 돌아보기 비서 (비워 두면 claude-sonnet-5-5)
# AI_MODEL=claude-sonnet-5-5
# 작은 모델: 끝났는지 확인, 맞춤법, 기록 정리, 끝 절 제안 (비워 두면 claude-haiku-5-5)
# AI_SMALL_MODEL=claude-haiku-5-5
# 한 가지 일만 다른 모델로. 예: 기록 정리를 Sonnet으로 되돌리기
# AI_MODEL_RECORD=claude-sonnet-5-5

# 답의 분량 한도. 생각에 쓰는 분량도 함께 계산되므로 넉넉히 둔다 (비워 두면 8000)
# AI_MAX_TOKENS=8000

# 접속 암호. 인터넷에 올릴 때 정해 두면 이 암호를 아는 사람만 묵상할 수 있다 (비워 두면 누구나 들어온다)
# APP_PASSCODE=

# 일기장(Firestore). 둘 다 비워 두면 일기장은 꺼져 있고, 묵상 기록은 기기에만 보관된다
# 서버가 Firestore에 쓰는 열쇠: 서비스 계정 키 JSON 전체를 한 줄로. 비밀이다
# FIREBASE_SERVICE_ACCOUNT=
# 화면이 로그인에 쓰는 설정: Firebase 웹 앱 설정 JSON을 한 줄로. 공개되어도 되는 값이다
# FIREBASE_WEB_CONFIG=
# 내 컴퓨터에서 로그인 없이 시험할 때만: 1
# DIARY_DEV_LOGIN=

# 화면을 다른 주소(Vercel)에 둘 때, 그 주소를 쉼표로 적는다. 비워 두면 같은 주소에서만 부를 수 있다
# ALLOWED_ORIGINS=https://diary-chat.vercel.app
